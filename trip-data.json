{"days": [{"date": "2026-12-24", "title": "First lakes, first night.", "country": "NZ", "region": "Canterbury to the Mackenzie Basin", "mode": "drive", "keys": ["chc", "tekapo", "pukaki", "twizel"], "via": [[171.245, -44.093], [170.826, -44.099]], "photos": ["tekapo", "pukaki", "twizel"], "metric": "4-5h driving allowance", "bed": "Twizel", "intro": "Arrive together, collect the car, then follow SH1 / SH79 / SH8 to Tekapo and Pukaki. Twizel is your first overnight base.", "timeline": [["08:35-10:00", "Land at Christchurch", "Immigration, bags and biosecurity; allow extra time for queues."], ["10:00-11:15", "Car pickup + breakfast", "Aim for pickup by 10:30; buy water, snacks and Christmas meals."], ["11:15-14:30", "Drive to Lake Tekapo", "Short rest break en route through Geraldine and Fairlie."], ["14:30-15:30", "Church + lakefront", "Lunch, photos and an easy walk. Interior access is not assumed."], ["15:30-16:45", "Lake Pukaki viewpoint", "45-60 minutes driving, then a short southern-shore stop."], ["16:45-17:30", "Twizel check-in", "Hotel still to be chosen; confirm its arrival window."], ["17:30 onward", "Dinner + early sleep", "Tomorrow is Christmas: use the food bought today."]], "note": "Arrival time comes from your selected flight option; it is not booked. If either of you needs sleep first, use a Christchurch day room or shorten today to Tekapo.", "source": ["Church / Pukaki", "https://www.churchofthegoodshepherd.org.nz/visit"], "stop_times": ["08:35", "14:30", "16:15", "17:15"], "map": "assets/maps/day-01-map.png"}, {"date": "2026-12-25", "title": "Into the Southern Alps.", "country": "NZ", "region": "Twizel - Mount Cook - Queenstown", "mode": "drive", "keys": ["twizel", "cook", "lindis", "queenstown"], "photos": ["cook", "lindis", "queenstown"], "metric": "5-6h driving allowance", "bed": "Queenstown", "intro": "A short alpine walk, then the long scenic transfer through the Mackenzie Basin, Lindis Pass and Cromwell.", "timeline": [["07:30-08:00", "Breakfast + check-out", "Packed food ready; check DOC alerts and weather."], ["08:00-09:15", "Drive to Mount Cook", "Follow SH80 beside Lake Pukaki."], ["09:30-11:30", "Kea Point / village views", "Short walk from White Horse Hill, subject to track access and weather."], ["11:30-12:15", "Packed lunch", "Christmas opening hours are not assumed."], ["12:15-17:45", "Drive to Queenstown", "Return south, cross Lindis Pass; include breaks and a lookout stop."], ["17:45-18:30", "Check-in + dinner", "Queenstown hotel to be booked; arrange Christmas dinner in advance."]], "note": "Use a short walk rather than adding Hooker Valley and a long hike. White Horse Hill parking is paid. Check DOC conditions before leaving Twizel.", "source": ["DOC Kea Point", "https://www.doc.govt.nz/parks-and-recreation/places-to-go/canterbury/places/aoraki-mount-cook-national-park/things-to-do/tracks/kea-point-track/"], "stop_times": ["08:00", "09:15", "14:15", "17:45"], "map": "assets/maps/day-02-map.png"}, {"date": "2026-12-26", "title": "A day in Fiordland.", "country": "NZ", "region": "Queenstown - Te Anau - Milford Sound", "mode": "coach", "keys": ["queenstown", "teanau", "mirror", "milford"], "return_route": true, "photos": ["teanau", "mirror", "milford"], "metric": "12-13h coach + cruise day", "bed": "Queenstown", "intro": "Let a coach driver handle Milford Road. Scenic stops lead to a 1.5-2 hour cruise beneath the fiord walls, then the same road back.", "timeline": [["06:00-06:30", "Breakfast + pack", "Rain layer, warm top, lunch and insect repellent."], ["06:45-07:00", "Coach pickup target", "Actual pickup comes from the tour you book."], ["07:00-12:00", "Te Anau + Milford Road", "The operator chooses stops; Mirror Lakes is representative."], ["12:00-14:00", "Milford Sound cruise", "Cruise time and meals depend on the selected departure."], ["14:00-19:30/20:00", "Return to Queenstown", "Allow about five hours coach travel with stops."], ["20:00 onward", "Dinner + sleep", "No extra driving or evening excursion planned."]], "note": "Tour-operated day: marker times and scenic stops are indicative. The map shows the outbound road; you return along it. Cruise path is not shown as a road.", "source": ["RealNZ coach + cruise", "https://www.realnz.com/en/experiences/day-cruises/milford-sound-day-trip-from-queenstown/"], "stop_times": ["06:45", "09:30", "10:30", "12:00"], "map": "assets/maps/day-03-map.png"}, {"date": "2026-12-27", "title": "Middle-earth, then Melbourne.", "country": "NZ", "region": "Queenstown - Glenorchy - airport", "mode": "drive", "keys": ["queenstown", "glenorchy", "zqn"], "via_after": [[168.6626, -45.0312]], "photos": ["glenorchy", "queenstown", "melbourne"], "metric": "2-3h local driving", "bed": "Melbourne airport area", "intro": "Spend the morning beside Lake Wakatipu and Glenorchy, then return for the flight to Melbourne. This is the LOTR landscape day.", "timeline": [["07:30-08:00", "Breakfast + check-out", "Leave luggage securely or with the hotel."], ["08:00-09:15", "Queenstown to Glenorchy", "Allow a scenic roadside stop on the lake road."], ["09:15-12:00", "Glenorchy / LOTR landscapes", "Lagoon walk and views, or a booked short guided tour."], ["12:00-14:00", "Lunch + return", "Back to Queenstown; collect bags and fuel the car."], ["14:00-16:30", "Queenstown free time", "Easy lakefront time. Arrowtown is optional, not included."], ["17:00-17:30", "Return car + airport check-in", "Allow international check-in time; rental branch to be chosen."], ["19:55 -> 21:30", "Flight candidate: ZQN -> MEL", "Local times; Melbourne is two hours behind NZ. Virgin option found, not booked."], ["22:15-23:00", "Hotel check-in target", "Airport-area stay is practical before the early road-trip start."]], "note": "27 Dec evening flight appeared in the Trip.com search. Reconfirm directly before booking. If you fly on 28 Dec instead, remove Wilsons Promontory from that day.", "source": ["LOTR locations", "https://www.newzealand.com/sg/feature/the-lord-of-the-rings-trilogy-filming-locations/"], "stop_times": ["08:00", "09:15", "17:00"], "map": "assets/maps/day-04-map.png"}, {"date": "2026-12-28", "title": "Beaches, boulders, Gippsland.", "country": "AU", "region": "Melbourne - Wilsons Prom - Lakes Entrance", "mode": "drive", "keys": ["mel", "squeaky", "tidal", "lakes"], "photos": ["melbourne", "squeaky", "lakes"], "metric": "7-8h driving allowance", "bed": "Lakes Entrance", "intro": "An early departure makes room for a short Wilsons Prom visit before the long drive through South Gippsland to Lakes Entrance.", "timeline": [["06:30-07:15", "Breakfast + rental pickup", "Pre-book an early airport pickup; confirm opening hours."], ["07:15-11:00", "Drive to Wilsons Prom", "Allow traffic and a rest break on the approach."], ["11:00-12:30", "Squeaky Beach + Tidal River", "Short beach/viewpoint visits and picnic; no long hike."], ["12:30-17:45/18:30", "Drive to Lakes Entrance", "A440 / Sale / Princes Highway, with fuel and breaks."], ["18:30-19:15", "Check-in + dinner", "Holiday park cabin or motel, subject to availability."], ["If energy allows", "Lakeside sunset stroll", "Keep it short after a substantial driving day."]], "note": "This is the most demanding driving day. Earlier estimates of 5-6 hours were too short for the full Wilsons Prom detour. Skip the Prom if delayed or if routing exceeds your eight-hour limit.", "source": ["Parks Victoria Squeaky Beach", "https://www.parks.vic.gov.au/places-to-see/parks/wilsons-promontory-national-park/things-to-do/squeaky-beach"], "stop_times": ["07:15", "11:00", "12:00", "18:30"], "map": "assets/maps/day-05-map.png"}, {"date": "2026-12-29", "title": "The Sapphire Coast northbound.", "country": "AU", "region": "Lakes Entrance - Eden - Batemans Bay", "mode": "drive", "keys": ["lakes", "eden", "merimbula", "narooma", "batemans"], "photos": ["eden", "merimbula", "narooma"], "metric": "6-7h driving allowance", "bed": "Batemans Bay", "intro": "Follow the Princes Highway through East Gippsland and the NSW South Coast. Choose a few short waterfront stops rather than a visit to every town.", "timeline": [["07:00-08:00", "Breakfast + check-out", "Fuel up and pack water."], ["08:00-11:00", "Drive to Eden", "Break en route; no Mallacoota detour today."], ["11:00-12:00", "Eden waterfront", "Short wharf/lookout visit and an early lunch."], ["12:00-13:15", "Merimbula stop", "A quick beach or inlet visit; do not add a long walk."], ["13:15-15:30", "Narooma + coast", "Drive north; one inlet/lookout break."], ["15:30-17:30/18:00", "Continue to Batemans Bay", "Final drive, then hotel check-in; allow traffic."], ["18:00 onward", "Dinner + waterfront", "Easy evening and prepare for tomorrow."]], "note": "Museum interiors, wildlife tours and beach swims are optional extras that need time or bookings. This page budgets short viewpoint stops only.", "source": ["Coastal touring route", "https://www.australia.com/en/trips-and-itineraries/sydney-and-surrounds/9-day-sydney-to-melbourne-coastal-drive.html"], "stop_times": ["08:00", "11:00", "12:30", "15:00", "17:30"], "map": "assets/maps/day-06-map.png"}, {"date": "2026-12-30", "title": "The coast delivers you to Sydney.", "country": "AU", "region": "Batemans Bay - Jervis Bay - Sydney", "mode": "drive", "keys": ["batemans", "huskisson", "kiama", "bridge", "audley", "sydney"], "via_between_bridge_audley": [[151.01, -34.169]], "photos": ["huskisson", "kiama", "bridge"], "metric": "5-6h driving allowance", "bed": "Sydney", "intro": "One Jervis Bay stop, then Kiama and the Sea Cliff Bridge. Cross Royal National Park and reach Sydney before New Year's Eve.", "timeline": [["06:30-07:00", "Breakfast + check-out", "Start early; the city is your fixed finish today."], ["07:00-10:00", "Jervis Bay / Huskisson", "Drive north, then one waterfront or beach stop."], ["10:00-12:15", "Kiama + lunch", "Allow about 75 minutes driving, then the blowhole."], ["12:15-14:30", "Sea Cliff Bridge", "Coastal detour through Wollongong; walk at legal access points."], ["14:30-16:30", "Royal National Park", "Brief Audley stop, subject to roads and parking."], ["16:30-18:30", "Sydney arrival + car return", "CBD return branch and hotel not chosen; allow traffic."], ["18:30 onward", "Check in + dinner", "Stay near public transport for tomorrow."]], "note": "If running late, shorten Jervis Bay and the Royal NP stop. Keep the Sydney arrival buffer rather than adding another detour.", "source": ["Grand Pacific Drive", "https://www.grandpacificdrive.com.au/"], "stop_times": ["07:00", "09:00", "11:15", "13:30", "15:30", "18:00"], "map": "assets/maps/day-07-map.png"}, {"date": "2026-12-31", "title": "The harbour, then midnight.", "country": "AU", "region": "Sydney Harbour / proposed free viewpoint", "mode": "walk", "keys": ["quay", "opera", "dawes"], "photos": ["opera", "harbour", "fireworks"], "metric": "Walking + long viewpoint wait", "bed": "Sydney", "intro": "An early harbour walk, then settle at the proposed Dawes Point viewing area. Midnight fireworks are the anchor of the trip.", "timeline": [["08:00-09:00", "Breakfast + supplies", "Water, permitted food, sunscreen and hat."], ["09:00-10:00", "Circular Quay / Opera House", "Exterior sightseeing before entering the viewing area."], ["10:00-11:00", "Enter Dawes Point target", "Free, first come; access is not guaranteed."], ["11:00-21:00", "Stay in the viewing area", "No re-entry. Plan for a long wait and limited shade."], ["21:00", "Early fireworks", "Keep your place for the midnight display."], ["00:00", "Midnight fireworks", "Welcome 2027 on Sydney Harbour."], ["00:30 onward", "Return when crowds permit", "Walk / public transport; expect queues and diversions."]], "note": "Dawes Point is a proposal, not a reservation, and has partial views. Current official rules include no alcohol, glass, camping or re-entry. Historic fireworks photo is illustrative.", "source": ["Official Dawes Point access", "https://www.sydneynewyearseve.com/vantage-points/dawes-point-tar-ra-park-the-rocks"], "stop_times": ["09:00", "09:30", "10:00"], "map": "assets/maps/day-08-map.png"}, {"date": "2027-01-01", "title": "A slower day by the water.", "country": "AU", "region": "Circular Quay - Manly - Shelly Beach", "mode": "ferry", "keys": ["quay", "manly", "manlybeach", "shelly"], "return_route": true, "photos": ["harbour", "manly", "shelly"], "metric": "Ferry + easy walking", "bed": "Sydney", "intro": "Sleep in after the fireworks, take the ferry to Manly, and walk beside the ocean. This page chooses Manly rather than trying to add Bondi too.", "timeline": [["10:00-11:00", "Late breakfast", "No early alarm after New Year's Eve."], ["11:30-12:15", "Ferry to Manly", "Aim for a regular ferry; timetable and queues determine the time."], ["12:15-14:00", "Manly lunch + beach", "Walk from the wharf to the oceanfront."], ["14:00-16:00", "Shelly Beach walk", "An easy coast walk; stop whenever you like."], ["16:00-17:30", "Return ferry + hotel", "Use the actual departure board; no fixed sailing booked."], ["Evening", "Dinner + early sleep", "Prepare for the Blue Mountains tomorrow."]], "note": "Blue dashed line is a schematic ferry connection, not a navigation track. January 1 holiday timetables and crowds may change the sequence.", "source": ["Manly destination guide", "https://www.sydney.com/destinations/sydney/sydney-north/manly"], "stop_times": ["11:30", "12:15", "13:00", "15:00"], "map": "assets/maps/day-09-map.png"}, {"date": "2027-01-02", "title": "One last mountain day.", "country": "AU", "region": "Sydney - Blue Mountains - Sydney", "mode": "drive", "keys": ["sydney", "echo", "leura", "wentworth"], "return_route": true, "photos": ["echo", "leura", "wentworth"], "metric": "4-5h driving allowance", "bed": "Sydney", "intro": "Three Sisters views, lunch in Leura and a short Wentworth Falls visit. Return to the same Sydney base and pack for India.", "timeline": [["07:00-08:00", "Rental pickup / tour departure", "Book the pickup or tour in advance."], ["08:00-10:00", "Drive to Echo Point", "Allow traffic, parking and a short break."], ["10:00-11:30", "Three Sisters views + walk", "Echo Point and the short Three Sisters Walk."], ["11:30-13:00", "Leura lunch", "Village stop with an easy walk."], ["13:00-15:00", "Wentworth Falls lookout", "A short walk, subject to track access. Scenic World is an alternative."], ["15:00-17:30", "Return to Sydney", "Allow holiday traffic; return the rental car."], ["17:30 onward", "Dinner + packing", "Passports, tickets and airport transfer ready."]], "note": "This route chooses Wentworth Falls. If you book Scenic World, substitute it rather than add it. Check NSW Parks alerts for walks before leaving.", "source": ["NSW Parks Katoomba", "https://www.nationalparks.nsw.gov.au/visit-a-park/parks/katoomba-area"], "stop_times": ["08:00", "10:00", "12:00", "14:00"], "map": "assets/maps/day-10-map.png"}, {"date": "2027-01-03", "title": "Home together, for now.", "country": "AU", "region": "Sydney Airport - Delhi", "mode": "departure", "keys": ["sydney", "syd"], "photos": ["opera", "harbour", "delhi"], "metric": "International flight - time TBC", "bed": "Delhi / in transit", "intro": "Fly from Sydney to Delhi. Onward travel and any extended stay can be arranged separately.", "timeline": [["Flight minus 5h", "Wake, pack and check out", "Exact wake-up depends on the booked flight and hotel."], ["Flight minus 4h", "Leave for Sydney Airport T1", "Allow traffic and the actual airport-transfer time."], ["Flight minus 3h", "International check-in", "Follow the airline's check-in and bag-drop deadlines."], ["Departure time TBC", "Fly Sydney -> Delhi", "Direct or connecting itinerary has not been chosen."], ["Arrival TBC", "Delhi arrival + home transfer", "Could be 3 or 4 January; confirm before booking."], ["After arrival", "Onward plans", "Allow time to rest before returning to work or continuing onward travel."]], "note": "Flight time and same-day arrival are not confirmed. Long-haul routing is not drawn because direct or connecting flights have not been chosen. Onward travel is outside this guide.", "source": ["Sydney Airport departures", "https://www.sydneyairport.com.au/info-sheet/departures"], "stop_times": ["Flight minus 4h", "Flight minus 3h"], "map": "assets/maps/day-11-map.png"}], "credits": {"tekapo": {"filename": "Church_of_the_Good_Shepherd,_Tekapo_01.jpg", "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/5/57/Church_of_the_Good_Shepherd%2C_Tekapo_01.jpg/960px-Church_of_the_Good_Shepherd%2C_Tekapo_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "caption": "Tekapo lakefront", "author": "russellstreet", "license": "CC BY-SA 2.0", "license_url": "https://creativecommons.org/licenses/by-sa/2.0", "source": "https://commons.wikimedia.org/wiki/File:Church_of_the_Good_Shepherd,_Tekapo_01.jpg", "local": "assets/photos/tekapo.jpg"}, "pukaki": {"filename": "LakePukakiNov232024_01.jpg", "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/0/08/LakePukakiNov232024_01.jpg/960px-LakePukakiNov232024_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "caption": "Lake Pukaki", "author": "Hagai Agmon-Snir حچاي اچمون-سنير חגי אגמון-שניר", "license": "CC BY-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-sa/4.0", "source": "https://commons.wikimedia.org/wiki/File:LakePukakiNov232024_01.jpg", "local": "assets/photos/pukaki.jpg"}, "twizel": {"filename": "Twizel_Tasman_Road.JPG", "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/2/21/Twizel_Tasman_Road.JPG/960px-Twizel_Tasman_Road.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "caption": "Twizel overnight", "author": "Mattinbgn (talk · contribs)", "license": "CC BY 3.0", "license_url": "https://creativecommons.org/licenses/by/3.0", "source": "https://commons.wikimedia.org/wiki/File:Twizel_Tasman_Road.JPG", "local": "assets/photos/twizel.jpg"}, "cook": {"filename": "Mt_Coo